# Google AdSense publisher ID and two 160 × 600 display ad units.
# These values are public and included in the browser bundle.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_LEFT_SLOT=
VITE_ADSENSE_RIGHT_SLOT=

# Use true for AdSense test ads during integration. Keep false for live ads.
VITE_ADSENSE_TEST_MODE=false
